#!/bin/sh
# Tests must pass locally before a push is accepted.
set -e

cd "$(git rev-parse --show-toplevel)"

# Resolve the hook's repository first; validation must not inherit its overrides.
unset GIT_DIR GIT_WORK_TREE GIT_INDEX_FILE GIT_COMMON_DIR GIT_PREFIX

echo "pre-push: pytest"
uv run pytest

if [ -d clients/menubar ] && command -v swift >/dev/null 2>&1; then
    echo "pre-push: swift build"
    (cd clients/menubar && swift build --quiet)
fi
